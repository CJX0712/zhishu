# 智枢 ZhiShu 环境变量（复制为 .env 后按需修改；前缀 ZHISHU_）
# 推理模式：local（仅本地）| cloud（仅云端）| hybrid（本地优先，失败/无密钥兜底云端）
ZHISHU_LLM_MODE=hybrid

# 本地推理（Ollama，OpenAI 兼容端点）
ZHISHU_LLM_LOCAL_BASE_URL=http://localhost:11434/v1
ZHISHU_LLM_LOCAL_MODEL=qwen2.5:1.5b

# 云端兜底（OpenAI 兼容，如 DeepSeek）
ZHISHU_LLM_CLOUD_BASE_URL=https://api.deepseek.com/v1
ZHISHU_LLM_CLOUD_MODEL=deepseek-chat
ZHISHU_LLM_CLOUD_API_KEY=

# 嵌入模型（fastembed 支持的模型名；中文 SOTA 小模型）
ZHISHU_EMBED_MODEL=BAAI/bge-small-zh-v1.5
# 可选：本地离线模型目录（含 model_optimized.onnx / tokenizer.json / tokenizer_config.json / config.json）。
# 非空则跳过 HuggingFace 下载，直接从该目录加载（适用于无外网/内网/复用已下载模型场景）。
# ZHISHU_EMBED_MODEL_PATH=.models/bge-small-zh-v1.5

# 向量库
ZHISHU_QDRANT_HOST=localhost
ZHISHU_QDRANT_PORT=6333
ZHISHU_COLLECTION_NAME=zhishu_docs

# 检索 / 重排
ZHISHU_RETRIEVAL_TOP_K=20
ZHISHU_FINAL_TOP_K=5
ZHISHU_RERANK_ENABLED=true
ZHISHU_RERANK_TYPE=hybrid
ZHISHU_CHUNK_SIZE=500
ZHISHU_CHUNK_OVERLAP=80
